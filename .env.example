# Clipper AI - Environment Variables
# Copy this file to .env.local to activate real API services

# 1. Google Gemini API (Get free at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Deepgram Speech-to-Text (Get $200 free credits at https://console.deepgram.com)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# 3. Pexels Stock B-Roll API (Recommended for 9:16 Vertical Video: https://www.pexels.com/api/)
PEXELS_API_KEY=your_pexels_api_key_here

# 4. Pixabay API (Alternative B-Roll & SFX Music: https://pixabay.com/api/docs/)
PIXABAY_API_KEY=your_pixabay_api_key_here

# 5. Fal.ai / Flux AI Images (Optional, https://fal.ai)
FAL_KEY=your_fal_key_here

# 6. Supabase Database (https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
